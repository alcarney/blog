213:147m\u001b[48:2::48:63:45m;; In particular, this means that pressing the ’<home>’ key moves the \u001b(B\u001b[0m\u001b[38:2::112:82:58m\u001b[48:2::48:63:45m│\u001b[38:2::208:226:200m        \r\n\u001b(B\u001b[0;1m\u001b[38:2::208:226:200m\u001b[48:2::48:63:45m    3 \u001b(B\u001b[0m\u001b[3m\u001b[38:2::176:213:147m\u001b[48:2::48:63:45m;; ’display-sort-function’, ’annotation-function’, ’affixation-function’, \u001b(B\u001b[0m\u001b[38:2::208:226:200m\u001b[48:2::48:63:45m      \u001b[32m\u001b[49m│\u001b[38:2::188:190:175m\u001b[48:2::48:63:45m    3 \u001b(B\u001b[0m\u001b[3m\u001b[38:2::176:213:147m\u001b[48:2::48:63:45m;; point to the beginning of your input, not the beginning of the whole \u001b(B\u001b[0m\u001b[38:2::208:226:200m\u001b[48:2::48:63:45m       \r\n\u001b[38:2::188:190:175m    4 \u001b(B\u001b[0m\u001b[3m\u001b[38:2::176:213:147m\u001b[48:2::48:63:45m;; and ’group-function’.  You can now customize them for any category in \u001b(B\u001b[0m\u001b[38:2::208:226:200m\u001b[48:2::48:63:45m       \u001b[32m\u001b[49m│\u001b[38:2::188:190:175m\u001b[48:2::48:63:45m    4 \u001b(B\u001b[0m\u001b[3m\u001b[38:2::176:213:147m\u001b[48:2::48:63:45m;; line.  If you want to go back to the old behavior, add something like \u001b(B\u001b[0m\u001b[38:2::208:226:200m\u001b[48:2::48:63:45m      \r\n\u001b[38:2::188:190:175m    5 \u001b(B\u001b[0m\u001b[3m\u001b[38:2::176:213:147m\u001b[48:2::48:63:45m;; ’completion-category-overrides’ that will override the properties \u001b(B\u001b[0m\u001b[38:2::208:226:200m\u001b[48:2::48:63:45m \u001b[38:2::112:82:58m│\u001b[38:2::208:226:200m         \u001b[32m\u001b[49m│\u001b[38:2::188:190:175m\u001b[48:2::48:63:45m    5 \u001b(B\u001b[0m\u001b[3m\u001b[38:2::176:213:147m\u001b[48:2::48:63:45m;; this to your configuration: \u001b(B\u001b[0m\u001b[38:2::208:226:200m\u001b[48:2::48:63:45m                                       \u001b[38:2::112:82:58m│\u001b[38:2::208:226:200m        \r\n\u001b[38:2::188:190:175m    6 \u001b